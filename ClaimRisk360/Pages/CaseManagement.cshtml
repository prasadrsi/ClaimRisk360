@page
@model ClaimRisk360.Pages.CaseManagementModel
@{
    ViewData["Title"] = "Case Management";
}

<h2 class="mb-4"><i class="bi bi-person-check"></i> Case Management &amp; Human Review</h2>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle"></i> @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="mb-3">
    <a asp-page="/CaseManagement" asp-route-StatusFilter="All" class="btn btn-sm btn-outline-secondary @(Model.StatusFilter is null or "All" ? "active" : "")">All</a>
    <a asp-page="/CaseManagement" asp-route-StatusFilter="Open" class="btn btn-sm btn-outline-warning @(Model.StatusFilter == "Open" ? "active" : "")">Open</a>
    <a asp-page="/CaseManagement" asp-route-StatusFilter="In Review" class="btn btn-sm btn-outline-info @(Model.StatusFilter == "In Review" ? "active" : "")">In Review</a>
    <a asp-page="/CaseManagement" asp-route-StatusFilter="Escalated" class="btn btn-sm btn-outline-danger @(Model.StatusFilter == "Escalated" ? "active" : "")">Escalated</a>
    <a asp-page="/CaseManagement" asp-route-StatusFilter="Resolved" class="btn btn-sm btn-outline-success @(Model.StatusFilter == "Resolved" ? "active" : "")">Resolved</a>
</div>

<div class="row">
    <div class="col-md-5">
        <div class="card">
            <div class="card-header"><strong>Cases (@Model.Cases.Count)</strong></div>
            <div class="list-group list-group-flush" style="max-height: 600px; overflow-y: auto;">
                @foreach (var c in Model.Cases)
                {
                    <a asp-page="/CaseManagement" asp-route-SelectedCaseId="@c.CaseId" asp-route-StatusFilter="@Model.StatusFilter"
                       class="list-group-item list-group-item-action @(c.CaseId == Model.SelectedCaseId ? "active" : "")">
                        <div class="d-flex justify-content-between">
                            <strong>@c.CaseId</strong>
                            <span class="badge @c.StatusBadgeClass">@c.Status</span>
                        </div>
                        <small>Claim: @c.ClaimId</small><br />
                        <small>
                            <span class="badge @c.PriorityBadgeClass">@c.Priority</span>
                            <i class="bi bi-person"></i> @c.AssignedTo
                        </small>
                    </a>
                }
            </div>
        </div>
    </div>

    <div class="col-md-7">
        @if (Model.SelectedCase is not null)
        {
            <div class="card mb-3">
                <div class="card-header">
                    <strong>@Model.SelectedCase.CaseId</strong> &mdash; @Model.SelectedCase.ClaimId
                    <span class="float-end badge @Model.SelectedCase.StatusBadgeClass">@Model.SelectedCase.Status</span>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <dl class="row mb-0">
                                <dt class="col-5">Priority</dt>
                                <dd class="col-7"><span class="badge @Model.SelectedCase.PriorityBadgeClass">@Model.SelectedCase.Priority</span></dd>
                                <dt class="col-5">Assigned To</dt>
                                <dd class="col-7">@Model.SelectedCase.AssignedTo</dd>
                                <dt class="col-5">Created</dt>
                                <dd class="col-7">@Model.SelectedCase.CreatedAt.ToString("MMM dd, yyyy")</dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            @if (Model.RelatedClaim is not null)
                            {
                                <dl class="row mb-0">
                                    <dt class="col-5">Patient</dt>
                                    <dd class="col-7">@Model.RelatedClaim.PatientName</dd>
                                    <dt class="col-5">Provider</dt>
                                    <dd class="col-7">@Model.RelatedClaim.ProviderName</dd>
                                    <dt class="col-5">Risk Score</dt>
                                    <dd class="col-7"><span class="badge @Model.RelatedClaim.RiskBadgeClass">@Model.RelatedClaim.FraudRiskScore</span></dd>
                                    <dt class="col-5">Amount</dt>
                                    <dd class="col-7">$@Model.RelatedClaim.Amount.ToString("N2")</dd>
                                </dl>
                            }
                        </div>
                    </div>

                    @if (Model.RelatedClaim is not null)
                    {
                        <div class="mb-3">
                            <a asp-page="/Explainability" asp-route-ClaimId="@Model.RelatedClaim.ClaimId" class="btn btn-sm btn-outline-info">
                                <i class="bi bi-lightbulb"></i> View AI Explanation
                            </a>
                        </div>
                    }

                    <!-- Supporting Documents -->
                    <div class="card mb-3">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <strong><i class="bi bi-paperclip"></i> Supporting Documents</strong>
                            <span class="badge bg-primary">@Model.Documents.Count</span>
                        </div>
                        @if (Model.Documents.Count > 0)
                        {
                            <div class="list-group list-group-flush" style="max-height: 200px; overflow-y: auto;">
                                @foreach (var doc in Model.Documents)
                                {
                                    <div class="list-group-item d-flex justify-content-between align-items-center py-2">
                                        <div>
                                            <i class="bi @doc.IconClass me-1"></i>
                                            <strong class="small">@doc.FileName</strong>
                                            <br />
                                            <small class="text-muted">@doc.DocumentType &bull; @doc.FileSizeDisplay &bull; @doc.UploadedAt.ToString("MMM dd")</small>
                                        </div>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge @doc.StatusBadgeClass">@doc.Status</span>
                                            <a asp-page="/DocumentViewer" asp-route-DocumentId="@doc.DocumentId" class="btn btn-sm btn-outline-primary" title="View document">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="card-body text-center text-muted py-3">
                                <i class="bi bi-folder2-open"></i> No documents
                            </div>
                        }
                    </div>

                    @if (Model.SelectedCase.Status != "Resolved")
                    {
                        @if (RoleAccess.Can(p => p.CanApproveClaim || p.CanEscalateClaim))
                        {
                        <div class="card bg-light">
                            <div class="card-body">
                                <h6><i class="bi bi-pencil-square"></i> Take Action</h6>
                                <form method="post">
                                    <input type="hidden" asp-for="SelectedCaseId" />
                                    <input type="hidden" asp-for="StatusFilter" />
                                    <div class="mb-2">
                                        <label class="form-label">Decision</label>
                                        <select asp-for="Decision" class="form-select" required>
                                            <option value="">Select action...</option>
                                            @if (RoleAccess.Can(p => p.CanApproveClaim))
                                            {
                                                <option value="Approve">Approve - Confirmed Legitimate</option>
                                            }
                                            <option value="Monitor">Monitor - Continue Observation</option>
                                            @if (RoleAccess.Can(p => p.CanEscalateClaim))
                                            {
                                                <option value="Escalate">Escalate - Suspected Fraud</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label">Justification (required)</label>
                                        <textarea asp-for="Justification" class="form-control" rows="3" required placeholder="Provide detailed justification for your decision..."></textarea>
                                    </div>
                                    <button type="submit" class="btn btn-primary"><i class="bi bi-check2-circle"></i> Submit Decision</button>
                                </form>
                            </div>
                        </div>
                        }
                        else
                        {
                            <div class="alert alert-warning mb-0">
                                <i class="bi bi-lock"></i> <strong>Read-only access</strong> — Your role (<em>@RoleAccess.GetCurrentRole().RoleName</em>) does not have permission to take actions on cases.
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-success mb-0">
                            <strong><i class="bi bi-check-circle"></i> Resolved</strong> &mdash; @Model.SelectedCase.Decision
                            <br /><small>@Model.SelectedCase.Justification</small>
                            <br /><small class="text-muted">Resolved on @Model.SelectedCase.ResolvedAt?.ToString("MMM dd, yyyy")</small>
                        </div>
                    }
                </div>
            </div>

            @if (Model.SelectedCase.History.Count > 0)
            {
                <div class="card">
                    <div class="card-header"><strong><i class="bi bi-clock-history"></i> Case History</strong></div>
                    <div class="card-body p-0">
                        <table class="table table-sm mb-0">
                            <thead class="table-light"><tr><th>Time</th><th>Action</th><th>By</th><th>Details</th></tr></thead>
                            <tbody>
                                @foreach (var entry in Model.SelectedCase.History.OrderByDescending(h => h.Timestamp))
                                {
                                    <tr>
                                        <td><small>@entry.Timestamp.ToString("MMM dd HH:mm")</small></td>
                                        <td><strong>@entry.Action</strong></td>
                                        <td>@entry.PerformedBy</td>
                                        <td><small>@entry.Details</small></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="alert alert-info">
                <i class="bi bi-arrow-left-circle"></i> Select a case from the list to review.
            </div>
        }
    </div>
</div>
